# Build settings for GitHub Pages deploy.
# `npm run build:pages` loads this file (Vite mode = "pages").
#
# VITE_BASE_PATH is overridden by the GitHub Actions workflow when it
# detects the repository name; the value below is the safe default for
# running `npm run build:pages` locally.
VITE_BASE_PATH=/gvriti-Tournament-Maker/

# Hash routing makes every deep link work on GitHub Pages without a
# 404.html fallback hack.
VITE_USE_HASH_ROUTER=true

# The deployed Pages build is public preview only. There is no backend at
# this URL, so the API client is pointed at a placeholder. Real workspace
# usage still requires running the backend locally and visiting
# http://127.0.0.1:5173.
VITE_API_BASE_URL=https://example.invalid/api/v1
